# PrintBot configuration. Copy to backend/.env (never commit real values).

# --- Core ---
ENV=development                 # development | production (production enforces safe settings at boot)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=printbot
SECRET_KEY=generate-a-random-48-char-string
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost

# --- Telegram (primary channel) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Optional, for webhook mode (long polling is used automatically when no webhook is set):
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# --- Payments ---
# demo     : order summary shows a "Pay (Demo)" button; no money moves. For testing.
# razorpay : real payment links + signed webhook. Required for ENV=production.
PAYMENT_MODE=demo
# Only needed when PAYMENT_MODE=razorpay (webhook URL: <PUBLIC_BASE_URL>/webhooks/razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp (optional) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Storage & printing ---
FILE_RETENTION_DAYS=7
MAX_FILE_SIZE_MB=50
MAX_COPIES=100
CUPS_HOST=localhost
CUPS_PORT=631
USE_VIRTUAL_PRINTER=true

# --- Business ---
BUSINESS_NAME=PrintBot Express
BUSINESS_PHONE=+910000000000
PICKUP_ADDRESS=Main Store, Central Library Complex, Campus Gate 1
