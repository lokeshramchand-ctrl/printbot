# PrintBot Production Configuration Environment Variables

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=printbot

# Admin Authentication
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# WhatsApp Business Cloud API Settings
WHATSAPP_ACCESS_TOKEN=your_whatsapp_business_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_API_VERSION=v19.0

# Razorpay Payment Gateway Settings
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Storage & File Retention
STORAGE_DIR=storage
FILE_RETENTION_DAYS=7
MAX_FILE_SIZE_MB=50

# CUPS Hardware / Virtual Driver Settings
CUPS_HOST=localhost
CUPS_PORT=631
USE_VIRTUAL_PRINTER=true

# Business Details
BUSINESS_NAME=PrintBot Express
BUSINESS_PHONE=+917287851999
PICKUP_ADDRESS=Main Store, Central Library Complex, Campus Gate 1
